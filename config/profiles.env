# Perfiles de Contención de Recursos (cgroups v2)
# PROFILE_A_BASELINE (Sin contención)
PROFILE_A_CPUS=4.0
PROFILE_A_MEMORY=4096m
PROFILE_A_MEM_SWAP=4096m

# PROFILE_B_MEDIUM (Contención media)
PROFILE_B_CPUS=2.0
PROFILE_B_MEMORY=2048m
PROFILE_B_MEM_SWAP=2048m

# PROFILE_C_SEVERE (Contención severa - throttling CFS activo)
PROFILE_C_CPUS=1.0
PROFILE_C_MEMORY=1024m
PROFILE_C_MEM_SWAP=1024m

